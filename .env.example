# =====================================================================
# SyncStock Microservices Environment Configuration
# Sao chép file này thành .env và điền đầy đủ trước khi chạy docker-compose.
# KHÔNG commit file .env vào git.
# =====================================================================

# --- Bảo mật JWT ---
# Sinh secret ngẫu nhiên >= 32 byte, ví dụ:
#   Linux/macOS: openssl rand -hex 32
#   PowerShell : -join ((1..32) | ForEach-Object { '{0:X2}' -f (Get-Random -Max 256) })
JWT_SECRET=

# --- Mật khẩu root MySQL ---
# Dùng cho tài khoản quản trị MySQL cao nhất (chỉ dùng bảo trì/khởi tạo hệ thống).
DB_PASSWORD=

# --- Tài khoản MySQL riêng cho từng Microservice (Least Privilege) ---
# auth-service (chỉ có quyền trên database auth_db)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

# inventory-service (chỉ có quyền trên database warehouse_db)
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_password

# supplier-service (chỉ có quyền trên database supplier_db)
SUPPLIER_DB_USER=supplier_user
SUPPLIER_DB_PASSWORD=supplier_password

# --- Tài khoản RabbitMQ ---
# Cần đặt tài khoản/mật khẩu mạnh, không dùng tài khoản mặc định.
RABBITMQ_USER=
RABBITMQ_PASS=

# --- Mật khẩu tài khoản admin khởi tạo (auth-service) ---
# Nếu để trống, DataSeeder sẽ tự sinh mật khẩu ngẫu nhiên (bạn cần đổi mật khẩu ngay sau đó).
# Độ dài tối thiểu 8 ký tự.
ADMIN_INITIAL_PASSWORD=

# --- Cấu hình Groq Cloud LLM cho ai-service (tùy chọn) ---
# Đăng ký lấy API key miễn phí tại: https://console.groq.com/keys
# Nếu để trống, ai-service chạy ở chế độ rule-based cục bộ (không gọi Groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
